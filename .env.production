# Build-time public config — read by `next build` (including Vercel builds).
# These values are publishable (they ship in the browser bundle by design):
# NEXT_PUBLIC_* vars are inlined into client JS, so keeping them here simply
# guarantees every deployment has them even if dashboard env vars are missing.
# Server-only secrets (CLOUDINARY_API_KEY/SECRET, AI_API_KEY, RESEND_API_KEY,
# SUPABASE_SECRET_KEY) must be set in the host's environment, never committed.
NEXT_PUBLIC_SUPABASE_URL=https://jelpluhryisspxeikguk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImplbHBsdWhyeWlzc3B4ZWlrZ3VrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE0MDQ3NDYsImV4cCI6MjEwNjk4MDc0Nn0.4sXj2WkyBeJemQxvP1zmSKfHvLp7rgzDLSDwzaDnlLU
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=ximyttx1
# Web Push VAPID public key (publishable - ships in the browser bundle).
# The matching VAPID_PRIVATE_KEY is server-only: set it (and
# SUPABASE_SECRET_KEY) in the Vercel dashboard, never commit them.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BILK31MA9VyxUJOYoNCBiBlHdVhm1iut31x3ozOxv1qSxx1GqyXw9b8c3a9MonXurR0fmlQTwLUI8dOWVF3NPMw
