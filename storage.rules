rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function underLimit(bytes) {
      return request.resource.size <= bytes;
    }

    // Profile photos: stored as "profile-photos/<uid>.<ext>".
    // The owner may only write their own file; reads are public (avatars).
    match /profile-photos/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && fileName.matches('^' + request.auth.uid + '\\..+')
        && isImage()
        && underLimit(5 * 1024 * 1024);
    }

    // Cover photos: stored as "cover-photos/<uid>.<ext>". Same rule as avatars.
    match /cover-photos/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && fileName.matches('^' + request.auth.uid + '\\..+')
        && isImage()
        && underLimit(5 * 1024 * 1024);
    }

    // Post images: uploaded as "posts/<uid>/<postId>/<name>" so the
    // owner can be verified against the authenticated user. The post
    // document may not exist yet at upload time, but the uid segment
    // proves the uploader owns the file.
    match /posts/{userId}/{postId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && isImage()
        && underLimit(10 * 1024 * 1024);
    }

    // Voice room covers: "voice/covers/<name>" — any signed-in user,
    // image only. Filenames are timestamp-based so collisions across
    // users are effectively impossible.
    match /voice/covers/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && isImage()
        && underLimit(10 * 1024 * 1024);
    }

    // Reels: "reels/<uid>/<timestamp>" — owner only, video only.
    match /reels/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && isVideo()
        && underLimit(100 * 1024 * 1024);
    }

    // Stories: "stories/<uid>/<name>" — owner only.
    match /stories/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && (isImage() || isVideo())
        && underLimit(20 * 1024 * 1024);
    }

    // Everything else in the bucket stays closed (OR semantics: the specific
    // matches above still allow their paths).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
