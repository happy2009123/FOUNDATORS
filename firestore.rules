rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    // Returns true if the request is from an authenticated user
    function isSignedIn() {
      return request.auth != null;
    }

    // Returns the UID of the currently authenticated user
    function uid() {
      return request.auth.uid;
    }

    // Returns true if the authenticated user is viewing their own document
    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    // ============================================================
    // ADMIN AUTHORIZATION (server-side, tamper-proof)
    // ============================================================
    // Admin status is determined ONLY by the existence of an
    // admins/{uid} document. That collection has no client write
    // path (see match /admins below), so it can only be seeded
    // once from the Firebase Console / Admin SDK — a normal user
    // can never grant themselves admin, and the frontend check is
    // purely cosmetic. Every admin capability below (reading
    // reports/analytics, moderating content, restricting users)
    // re-verifies this on the server via exists(), so a tampered
    // client still gets permission-denied.
    // ============================================================
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A Founding Member grant must reference a marker document in
    // foundingMembers/{N} (admin-created in the same batch), which
    // makes each of the 100 numbers physically unique — two admins
    // racing for the same number cannot both win, because only one
    // marker doc can ever exist per id.
    function foundingNumberValid(userId, number) {
      return number is int
        && number >= 1
        && number <= 100
        && exists(/databases/$(database)/documents/foundingMembers/$(number))
        && get(/databases/$(database)/documents/foundingMembers/$(number)).data.uid == userId;
    }

    // A signed-in user may add or remove ONLY their own uid from a
    // project's follower list — one element at a time, no bulk edits,
    // no rewriting other people's follows.
    function projectFollowToggled() {
      return request.resource.data.followers is list
        && request.resource.data.followers.toSet()
             .difference(resource.data.get('followers', []).toSet()).size() <= 1
        && resource.data.get('followers', []).toSet()
             .difference(request.resource.data.followers.toSet()).size() <= 1
        && (resource.data.get('followers', []).toSet()
             .difference(request.resource.data.followers.toSet()).size() == 0
            || resource.data.get('followers', []).toSet()
             .difference(request.resource.data.followers.toSet()).hasOnly([uid()]))
        && (request.resource.data.followers.toSet()
             .difference(resource.data.get('followers', []).toSet()).size() == 0
            || request.resource.data.followers.toSet()
             .difference(resource.data.get('followers', []).toSet()).hasOnly([uid()]));
    }

    // Generic "you may only add or remove YOUR OWN uid from this
    // list field" guard — used for event attendees, challenge
    // participants and idea upvotes. One element at a time, no
    // touching other people's entries.
    function selfToggled(field) {
      return request.resource.data.get(field, []) is list
        && request.resource.data.get(field, []).toSet()
             .difference(resource.data.get(field, []).toSet()).size() <= 1
        && resource.data.get(field, []).toSet()
             .difference(request.resource.data.get(field, []).toSet()).size() <= 1
        && (resource.data.get(field, []).toSet()
             .difference(request.resource.data.get(field, []).toSet()).size() == 0
            || resource.data.get(field, []).toSet()
             .difference(request.resource.data.get(field, []).toSet()).hasOnly([uid()]))
        && (request.resource.data.get(field, []).toSet()
             .difference(resource.data.get(field, []).toSet()).size() == 0
            || request.resource.data.get(field, []).toSet()
             .difference(resource.data.get(field, []).toSet()).hasOnly([uid()]));
    }

    // Validates that required string fields exist and are non-empty
    function isValidString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // Validates that a timestamp field exists
    function isValidTimestamp(value) {
      return value is timestamp;
    }

    // Validates that a field is a non-empty array
    function isNonEmptyArray(value) {
      return value is list && value.size() > 0;
    }

    // ============================================================
    // FOUNDING 100 — foundingMembers/{number}
    // One marker doc per badge number (1–100), created only by an
    // admin alongside the user's foundingNumber field. Users can
    // never write here; the marker doubles as the public roster at
    // /founding-100. No update path: grant = create, revoke = delete.
    // ============================================================
    match /foundingMembers/{memberNumber} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && memberNumber.matches('^(100|[1-9][0-9])$')
        && request.resource.data.keys().hasAll(['uid', 'name', 'createdAt'])
        && isValidString(request.resource.data.uid, 128)
        && isValidString(request.resource.data.name, 100)
        && isValidTimestamp(request.resource.data.createdAt);
      allow delete: if isAdmin();
    }

    // ============================================================
    // USERS COLLECTION
    // users/{userId}
    // ============================================================
    match /users/{userId} {

      // ----------------------------------------------------------
      // USER PROFILES
      // ----------------------------------------------------------
      // Public profile: any authenticated user can read.
      // Only the profile owner can create, update, or delete it.
      // ----------------------------------------------------------

      // READ: Any signed-in user can read any profile (public directory)
      allow read: if isSignedIn();

      // CREATE: Users can only create their own profile
      // Ensures all required fields are present and valid, and that
      // admin-managed fields (status/verified/founding/organizer/
      // builderScore) can never be smuggled in at signup time either.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
             'status', 'verified', 'foundingNumber',
             'foundingApprovedAt', 'organizer', 'builderScore'
           ])
        && request.resource.data.keys().hasAll([
             'name', 'handle', 'bio', 'avatar', 'role',
             'location', 'updatedAt'
           ])
        && isValidString(request.resource.data.name, 100)
        && isValidString(request.resource.data.handle, 50)
        && request.resource.data.bio is string
        && request.resource.data.avatar is string
        && request.resource.data.role is string
        && request.resource.data.location is string
        && isValidTimestamp(request.resource.data.updatedAt);

      // UPDATE: Users can only update their own profile.
      // `status` (moderation state) and `verified` are admin-managed —
      // an owner must never clear their own restriction or grant
      // themselves a verification badge. The same lockout covers the
      // Founding 100 number, the organizer role and Builder Score:
      // those can only ever be set by an admin (founding/organizer)
      // or computed on read (Builder Score is never stored).
      // Validates changed fields if they are present
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['status', 'verified', 'foundingNumber',
                      'foundingApprovedAt', 'organizer', 'builderScore',
                      'followers', 'following'])
        && (!request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['name', 'handle', 'bio', 'avatar',
                       'role', 'location', 'updatedAt'])
            || (isValidString(request.resource.data.name, 100)
                && isValidString(request.resource.data.handle, 50)
                && request.resource.data.bio is string
                && request.resource.data.avatar is string
                && request.resource.data.role is string
                && request.resource.data.location is string
                && isValidTimestamp(request.resource.data.updatedAt)));

      // ADMIN: may set the moderation status, verification badge,
      // Founding 100 membership or organizer role on any user —
      // nothing else on the profile can be touched. A founding
      // number is only accepted when its unique marker doc exists.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'verified', 'foundingNumber',
                       'foundingApprovedAt', 'organizer'])
        && (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['verified', 'foundingNumber',
                        'foundingApprovedAt', 'organizer'])
            || request.resource.data.status in ['active', 'restricted', 'suspended'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified'])
            || request.resource.data.verified is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['foundingNumber'])
            || (!request.resource.data.keys().hasAny(['foundingNumber'])
                || foundingNumberValid(userId, request.resource.data.foundingNumber)))
        && (!request.resource.data.keys().hasAny(['foundingApprovedAt'])
            || request.resource.data.foundingApprovedAt is timestamp);

      // FOLLOW COUNTER: another signed-in user may bump this profile's
      // `followers` counter by exactly ±1 as part of the follow/unfollow
      // transaction (no other field may change). The change must agree
      // with the follow record in the SAME batch: a +1 only when this
      // batch creates my followers/{uid} doc, a -1 only when it deletes
      // it — so nobody can inflate or drain counts without moving the
      // actual follow graph (existsAfter sees the post-batch state).
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
        && request.resource.data.followers is int
        && request.resource.data.followers >= 0
        && ((request.resource.data.followers
              == resource.data.get('followers', 0) + 1
             && !exists(/databases/$(database)/documents/users/$(userId)/followers/$(uid()))
             && existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(uid())))
            || (request.resource.data.followers
              == resource.data.get('followers', 0) - 1
             && exists(/databases/$(database)/documents/users/$(userId)/followers/$(uid()))
             && !existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(uid()))));

      // FOLLOWING COUNTER: only the owner may bump their own `following`
      // counter, by exactly ±1 and never negative. The matching
      // subcollection record is keyed by the TARGET user (whose id the
      // rules cannot derive from this write), so unlike `followers` it
      // cannot be anchored to existsAfter — the trade-off is that an
      // owner can nudge their own following number, which is cosmetic
      // only: the real follow graph lives in the subcollections and all
      // social features read that, never this counter.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['following'])
        && request.resource.data.following is int
        && request.resource.data.following >= 0
        && (request.resource.data.following
              == resource.data.get('following', 0) + 1
            || request.resource.data.following
              == resource.data.get('following', 0) - 1);

      // DELETE: owner (account removal) or admin (moderation removal,
      // always behind an explicit confirmation workflow in the UI)
      allow delete: if isOwner(userId) || isAdmin();

      // ----------------------------------------------------------
      // NOTIFICATIONS SUBCOLLECTION
      // users/{userId}/notifications/{notificationId}
      // ----------------------------------------------------------
      // Only the notification owner can read or manage their
      // notifications. No other user should ever access them.
      // ----------------------------------------------------------
      match /notifications/{notificationId} {
        allow read, update: if isOwner(userId);
        // Previously ANY signed-in user could write into ANY user's
        // notification feed with any actorKey — i.e. perfect spoofing
        // plus arbitrary spam. Now the writer must be the actor they
        // claim to be, the recipient themselves (self reminders), or
        // an admin.
        allow create: if isSignedIn()
          && request.resource.data.keys().hasAll([
               'type', 'actorKey', 'text', 'read',
               'linkType', 'linkId', 'createdAt'
             ])
          && (request.resource.data.actorKey == uid()
              || uid() == userId
              || isAdmin())
          && isValidString(request.resource.data.type, 60)
          && isValidString(request.resource.data.actorKey, 128)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.read is bool
          && (!request.resource.data.keys().hasAny(['actorName'])
              || request.resource.data.actorName is string)
          && (request.resource.data.linkType == null
              || request.resource.data.linkType is string)
          && (request.resource.data.linkId == null
              || request.resource.data.linkId is string)
          && isValidTimestamp(request.resource.data.createdAt);
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------------------------
      // ACHIEVEMENTS SUBCOLLECTION
      // users/{userId}/achievements/{achievementId}
      // ----------------------------------------------------------
      // Earned by finishing Founder Challenges. Readable by any
      // signed-in user (they appear on public profiles), created
      // only by the owner through the challenge flow, permanent
      // afterwards — no edits, no self-deletion of the record.
      // ----------------------------------------------------------
      match /achievements/{achievementId} {
        allow read: if isSignedIn();
        // Owner earns it through the challenge flow; admins may
        // also grant achievements (community awards, spotlights).
        allow create: if (isOwner(userId) || isAdmin())
          && request.resource.data.keys().hasAll(['title', 'source', 'earnedAt'])
          && isValidString(request.resource.data.title, 80)
          && request.resource.data.source is string
          && request.resource.data.source.size() <= 50
          && isValidTimestamp(request.resource.data.earnedAt);
        allow update: if false;
        allow delete: if isAdmin();
      }

      // ----------------------------------------------------------
      // REFERRAL INVITES SUBCOLLECTION
      // users/{inviterUid}/invites/{invitedUserId}
      // ----------------------------------------------------------
      // Lives under the INVITER but is created by the person who
      // actually joined (doc id must equal the caller's uid), so a
      // user can never fabricate invites for other people. The
      // activation flag flips on only after the invitee performs a
      // real meaningful action in the app.
      // The invite must reference the inviter (invitedUid == userId)
      // AND the invitee's user doc must already have invitedBy == userId.
      // ----------------------------------------------------------
      match /invites/{invitedUserId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && uid() == invitedUserId
          && request.resource.data.keys().hasAll(['invitedUid', 'joinedAt'])
          && request.resource.data.invitedUid == userId
          && isValidTimestamp(request.resource.data.joinedAt)
          // getAfter (not get) so a client that batches the invitedBy
          // write with the invite create in one transaction also passes;
          // for sequential writes the two are equivalent.
          && getAfter(/databases/$(database)/documents/users/$(uid())).data.invitedBy == userId;
        allow update: if isSignedIn() && uid() == invitedUserId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['activated'])
          && request.resource.data.activated is bool;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // ----------------------------------------------------------
      // COLLABORATION REQUESTS SUBCOLLECTION
      // users/{recipientUid}/collabRequests/{requesterUid}
      // ----------------------------------------------------------
      // Created only by the requester (doc id = requester uid, so
      // requests are idempotent and cannot be faked for others).
      // Only the RECIPIENT may accept or decline — and only the
      // status field may ever change. Either side may withdraw a
      // pending request.
      // ----------------------------------------------------------
      match /collabRequests/{requesterUid} {
        allow read: if isAdmin()
          || (isSignedIn() && (userId == uid() || requesterUid == uid()));
        allow create: if isSignedIn()
          && requesterUid == uid()
          && userId != uid()
          && request.resource.data.keys()
               .hasAll(['uid', 'name', 'message', 'status', 'createdAt'])
          && request.resource.data.uid == uid()
          && isValidString(request.resource.data.uid, 128)
          && isValidString(request.resource.data.name, 100)
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 1000
          && request.resource.data.status == 'pending'
          && isValidTimestamp(request.resource.data.createdAt);
        allow update: if isSignedIn()
          && userId == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedAt'])
          && request.resource.data.status in ['accepted', 'declined']
          && (!request.resource.data.keys().hasAny(['reviewedAt'])
              || request.resource.data.reviewedAt is timestamp);
        allow delete: if isAdmin()
          || (isSignedIn()
              && (resource.data.uid == uid() || userId == uid()));
      }

      // ----------------------------------------------------------
      // FOLLOWERS SUBCOLLECTION
      // users/{userId}/followers/{followerId}
      // ----------------------------------------------------------
      // Any authenticated user can see who follows a profile.
      // Only the follower themselves can add or remove their
      // own follow record.
      // ----------------------------------------------------------
      match /followers/{followerId} {
        allow read: if isSignedIn();
        // A follower can only add themselves to someone's followers list
        allow create: if isSignedIn() && uid() == followerId
          && request.resource.data.keys().hasAll(['followedAt'])
          && isValidTimestamp(request.resource.data.followedAt);
        // A follower can only remove themselves
        allow delete: if isSignedIn() && uid() == followerId;
        // No updates allowed on follow records
        allow update: if false;
      }

      // ----------------------------------------------------------
      // FOLLOWING SUBCOLLECTION
      // users/{userId}/following/{followingId}
      // ----------------------------------------------------------
      // The following graph is public (like followers) so any profile's
      // follower/following lists can be rendered; only the owner can
      // manage their own records.
      // ----------------------------------------------------------
      match /following/{followingId} {
        allow read: if isSignedIn();
        // The user can follow any other user (followingId = who they follow)
        allow create: if isOwner(userId)
          && followingId != userId
          && request.resource.data.keys().hasAll(['followedAt'])
          && isValidTimestamp(request.resource.data.followedAt);
        // The user can only remove their own following record
        allow delete: if isOwner(userId);
        // No updates allowed on following records
        allow update: if false;
      }

      // ----------------------------------------------------------
      // SETTINGS SUBCOLLECTION (privacy / notification prefs)
      // users/{userId}/settings/{settingId}
      // ----------------------------------------------------------
      // Private preferences: only the owner may read or write them.
      // ----------------------------------------------------------
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // ----------------------------------------------------------
      // BOOKMARKS SUBCOLLECTION
      // users/{userId}/bookmarks/{postId}
      // ----------------------------------------------------------
      // Only the owner can see or manage their saved posts.
      // ----------------------------------------------------------
      match /bookmarks/{postId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['postId', 'createdAt'])
          && isValidTimestamp(request.resource.data.createdAt);
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      // ----------------------------------------------------------
      // AI COPILOT CONVERSATIONS SUBCOLLECTION
      // users/{userId}/copilotConversations/{conversationId}
      // ----------------------------------------------------------
      // Private AI workspace. Only the owner can read or write the
      // conversation, its messages, and any generated payloads.
      // ----------------------------------------------------------
      match /copilotConversations/{conversationId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['title', 'mode', 'createdAt', 'updatedAt'])
          && isValidString(request.resource.data.title, 200)
          && isValidString(request.resource.data.mode, 30)
          && isValidTimestamp(request.resource.data.createdAt)
          && isValidTimestamp(request.resource.data.updatedAt);
        allow update: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && request.resource.data.keys().hasAll(['role', 'text', 'createdAt'])
            && request.resource.data.role in ['user', 'assistant']
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 12000
            && isValidTimestamp(request.resource.data.createdAt);
          allow update, delete: if isOwner(userId);
        }
      }
    }

    // ============================================================
    // POSTS COLLECTION
    // posts/{postId}
    // ============================================================
    // Any authenticated user can read posts (feed / explore).
    // Only the post author can create, update, or delete their
    // own posts.
    // ============================================================
    match /posts/{postId} {

      // READ: Any signed-in user can read any post
      allow read: if isSignedIn();

      // CREATE: Only authenticated users; authorKey must match the
      // authenticated user; all required fields must be present
      allow create: if isSignedIn()
        && request.resource.data.authorKey == uid()
        && request.resource.data.keys().hasAll([
             'text', 'authorKey', 'authorName', 'authorAvatar',
             'tagType', 'imageUrl', 'likes', 'shares',
             'commentsCount', 'likedBy', 'bookmarkedBy', 'createdAt'
           ])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000
        && isValidString(request.resource.data.authorKey, 128)
        && isValidString(request.resource.data.authorName, 100)
        && request.resource.data.authorAvatar is string
        && request.resource.data.tagType is string
        && (request.resource.data.imageUrl is string || request.resource.data.imageUrl == null)
        && request.resource.data.likes is int
        && request.resource.data.shares is int
        && request.resource.data.commentsCount is int
        && request.resource.data.likedBy is list
        && request.resource.data.bookmarkedBy is list
        && isValidTimestamp(request.resource.data.createdAt);

      // UPDATE: Two allowed paths —
      //  1. Anyone signed in may toggle their OWN like/bookmark entry
      //     and bump the comment counter, but only within a strict
      //     field allowlist: `likes` must move exactly with `likedBy`,
      //     `bookmarkedBy` may only gain/lose the caller, and
      //     `commentsCount` may move by at most 1 and never below 0.
      //     (Before this, any account could rewrite any post's
      //     likedBy/likes/commentsCount wholesale.)
      //  2. Only the author can edit post content, and only content
      //     fields — engagement state is off-limits to the author too.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'likedBy', 'bookmarkedBy', 'likes', 'commentsCount'
           ])
        && selfToggled('likedBy')
        && selfToggled('bookmarkedBy')
        && request.resource.data.get('likes', 0) is int
        && request.resource.data.get('likes', 0) >= 0
        && request.resource.data.get('likes', 0)
             == resource.data.get('likes', 0)
                + (request.resource.data.get('likedBy', []).size()
                   - resource.data.get('likedBy', []).size())
        && request.resource.data.get('commentsCount', 0) is int
        && request.resource.data.get('commentsCount', 0) >= 0
        && request.resource.data.get('commentsCount', 0)
             <= resource.data.get('commentsCount', 0) + 1
        && request.resource.data.get('commentsCount', 0)
             >= resource.data.get('commentsCount', 0) - 1;
      allow update: if isSignedIn()
        && resource.data.authorKey == uid()
        && request.resource.data.authorKey == resource.data.authorKey
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['text', 'tagType', 'imageUrl', 'updatedAt']);

      // DELETE: Only the author can delete their own post; admins can
      // remove posts as part of moderation (logged via adminActions)
      allow delete: if (isSignedIn() && resource.data.authorKey == uid())
        || isAdmin();

      // ----------------------------------------------------------
      // COMMENTS SUBCOLLECTION
      // posts/{postId}/comments/{commentId}
      // ----------------------------------------------------------
      // Any authenticated user can read and add comments.
      // Only the comment author can edit or delete their own.
      // ----------------------------------------------------------
      match /comments/{commentId} {

        // READ: Any signed-in user can read comments on any post
        allow read: if isSignedIn();

        // CREATE: Any authenticated user can comment; authorKey
        // must match the authenticated user
        allow create: if isSignedIn()
          && request.resource.data.authorKey == uid()
          && request.resource.data.keys().hasAll([
               'text', 'authorKey', 'authorName', 'authorAvatar',
               'replyTo', 'likes', 'likedBy', 'createdAt', 'edited'
             ])
          && isValidString(request.resource.data.text, 2000)
          && isValidString(request.resource.data.authorKey, 128)
          && isValidString(request.resource.data.authorName, 100)
          && request.resource.data.authorAvatar is string
          && (request.resource.data.replyTo is string || request.resource.data.replyTo == null)
          && request.resource.data.likes is int
          && request.resource.data.likedBy is list
          && isValidTimestamp(request.resource.data.createdAt)
          && request.resource.data.edited is bool;

        // UPDATE: Anyone can toggle their OWN like on a comment, and
        // `likes` must move exactly with `likedBy`; only the comment
        // author can edit the comment text (content fields only).
        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'likedBy', 'likes'
             ])
          && selfToggled('likedBy')
          && request.resource.data.get('likes', 0) is int
          && request.resource.data.get('likes', 0) >= 0
          && request.resource.data.get('likes', 0)
               == resource.data.get('likes', 0)
                  + (request.resource.data.get('likedBy', []).size()
                     - resource.data.get('likedBy', []).size());
        allow update: if isSignedIn()
          && resource.data.authorKey == uid()
          && request.resource.data.authorKey == resource.data.authorKey
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['text', 'edited', 'updatedAt']);

        // DELETE: comment author, admin, or the author of the post the
        // comment lives on. deletePost() batch-clears all comments when a
        // post is removed — without the post-author clause the whole batch
        // fails whenever someone ELSE commented, making posts undeletable.
        allow delete: if (isSignedIn()
          && resource.data.authorKey == uid())
          || isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/posts/$(postId)).data.authorKey == uid());
      }
    }

    // ============================================================
    // PROJECTS COLLECTION
    // projects/{projectId}
    // ============================================================
    // Real founder projects (created from the AI Copilot MVP roadmap).
    // Any signed-in user can browse them; only the owner (or an admin)
    // can change or delete one, and tasks inherit the owner check from
    // their parent project.
    // ============================================================
    match /projects/{projectId} {

      // READ: any authenticated user (projects surface in /projects
      // and on profiles as collaboration listings)
      allow read: if isSignedIn();

      // CREATE: the authenticated user must own the project and be
      // listed as its only initial member
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.keys().hasAll([
             'name', 'description', 'ownerUid', 'ownerName',
             'members', 'tasksTotal', 'tasksDone', 'progress',
             'createdAt', 'updatedAt'
           ])
        && isValidString(request.resource.data.name, 120)
        && isValidString(request.resource.data.description, 4000)
        && isValidString(request.resource.data.ownerUid, 128)
        && isValidString(request.resource.data.ownerName, 100)
        && request.resource.data.members is list
        && uid() in request.resource.data.members
        && request.resource.data.tasksTotal is int
        && request.resource.data.tasksDone is int
        && request.resource.data.progress is int
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt)
        && (!request.resource.data.keys().hasAny(['category'])
            || (request.resource.data.category is string
                && request.resource.data.category.size() <= 50))
        && (!request.resource.data.keys().hasAny(['stage'])
            || (request.resource.data.stage is string
                && request.resource.data.stage.size() <= 30))
        && (!request.resource.data.keys().hasAny(['skillsNeeded'])
            || request.resource.data.skillsNeeded is list)
        && (!request.resource.data.keys().hasAny(['goals'])
            || (request.resource.data.goals is string
                && request.resource.data.goals.size() <= 2000))
        && (!request.resource.data.keys().hasAny(['teamRequirements'])
            || (request.resource.data.teamRequirements is string
                && request.resource.data.teamRequirements.size() <= 1000))
        && (!request.resource.data.keys().hasAny(['followers'])
            || request.resource.data.followers is list);

      // UPDATE: owner (progress, tasks, metadata) or admin (moderation)
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == uid());

      // FOLLOWERS: any signed-in user toggling only their own entry
      // in the follower list (add/remove single uid, nothing else).
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['followers'])
        && projectFollowToggled();

      // DELETE: owner or admin
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == uid());

      // ----------------------------------------------------------
      // APPLICATIONS SUBCOLLECTION
      // projects/{projectId}/applications/{applicationId}
      // ----------------------------------------------------------
      // Doc id = applicant uid (no duplicate applications). Created
      // only by the applicant (never the owner), decided only by the
      // project owner. Accepting updates project.members via the
      // owner's project-update path above.
      // ----------------------------------------------------------
      match /applications/{applicationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && applicationId == uid()
          && request.resource.data.uid == uid()
          && request.resource.data.keys()
               .hasAll(['uid', 'name', 'message', 'status', 'createdAt'])
          && isValidString(request.resource.data.uid, 128)
          && isValidString(request.resource.data.name, 100)
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 1000
          && request.resource.data.status == 'pending'
          && isValidTimestamp(request.resource.data.createdAt)
          && get(/databases/$(database)/documents/projects/$(projectId))
               .data.ownerUid != uid();
        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId))
               .data.ownerUid == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedAt'])
          && request.resource.data.status in ['accepted', 'declined']
          && (!request.resource.data.keys().hasAny(['reviewedAt'])
              || request.resource.data.reviewedAt is timestamp);
        allow delete: if isAdmin()
          || (isSignedIn()
              && (resource.data.uid == uid()
                  || get(/databases/$(database)/documents/projects/$(projectId))
                       .data.ownerUid == uid()));
      }

      // ----------------------------------------------------------
      // QUESTIONS SUBCOLLECTION
      // projects/{projectId}/questions/{questionId}
      // ----------------------------------------------------------
      // Any signed-in user may ask; the asker or the project owner
      // (or an admin) may remove a question.
      // ----------------------------------------------------------
      match /questions/{questionId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorKey == uid()
          && request.resource.data.keys()
               .hasAll(['text', 'authorKey', 'authorName', 'createdAt'])
          && isValidString(request.resource.data.text, 1000)
          && isValidString(request.resource.data.authorKey, 128)
          && isValidString(request.resource.data.authorName, 100)
          && isValidTimestamp(request.resource.data.createdAt);
        allow delete: if isAdmin()
          || (isSignedIn()
              && (resource.data.authorKey == uid()
                  || get(/databases/$(database)/documents/projects/$(projectId))
                       .data.ownerUid == uid()));
      }

      // ----------------------------------------------------------
      // PROJECT TASKS SUBCOLLECTION
      // projects/{projectId}/tasks/{taskId}
      // ----------------------------------------------------------
      // Readable by signed-in users; only the parent project's owner
      // (or an admin) may create, update, or delete tasks.
      // ----------------------------------------------------------
      match /tasks/{taskId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == uid()
          && request.resource.data.keys().hasAll(['title', 'status', 'order', 'createdAt'])
          && isValidString(request.resource.data.title, 300)
          && request.resource.data.status in ['todo', 'in_progress', 'done']
          && request.resource.data.order is int
          && isValidTimestamp(request.resource.data.createdAt);
        allow update, delete: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == uid());
      }
    }

    // ============================================================
    // CHATS COLLECTION
    // chats/{chatId}
    // ============================================================
    // Only participants in a chat can read, write, or manage it.
    // Any signed-in user can create a chat but must include
    // themselves in the participants array. Chat IDs for DMs are
    // deterministic (sorted join with '__'); for groups we require
    // a group-sized ID pattern so a group chat can never squat a
    // pair ID.
    // ============================================================
    match /chats/{chatId} {

      // READ: Participants can read chat metadata (admins can, too —
      // read-only monitoring in the admin console). Also allow
      // reading a chat that DOES NOT EXIST yet, so the client can
      // detect "no conversation yet" and auto-create one, instead
      // of getting a false "permission denied".
      allow read: if isSignedIn()
        && (isAdmin()
            || !exists(/databases/$(database)/documents/chats/$(chatId))
            || uid() in resource.data.participants);

      // CREATE: Tight binding between the doc ID and the participants
      // list. For 1:1 chats the ID must be either participant ordering.
      // For groups (3+ participants) the ID must contain at least two
      // '__' separators so it can never match a pair ID. The creator
      // must be in participants, participants must be unique, and the
      // isGroup flag must match the size.
      allow create: if isSignedIn()
        && uid() in request.resource.data.participants
        && isNonEmptyArray(request.resource.data.participants)
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 50
        && request.resource.data.participants.toSet().size()
             == request.resource.data.participants.size()
        && request.resource.data.isGroup is bool
        && ((request.resource.data.participants.size() == 2
             && request.resource.data.isGroup == false
             && (chatId == request.resource.data.participants[0] + '__' + request.resource.data.participants[1]
                 || chatId == request.resource.data.participants[1] + '__' + request.resource.data.participants[0]))
            || (request.resource.data.participants.size() >= 3
                && request.resource.data.isGroup == true
                && chatId.matches('^.*__.*__.*$')));

      // UPDATE: Participants may only update chat metadata fields.
      // participants, isGroup, and createdAt are immutable. .get() is
      // used for the flags so legacy chats created before those fields
      // existed can still receive lastMessage/unread updates.
      allow update: if isSignedIn()
        && uid() in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.get('isGroup', false)
             == resource.data.get('isGroup', false)
        && request.resource.data.get('createdAt', null)
             == resource.data.get('createdAt', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'participantNames', 'participantAvatars', 'groupName',
             'lastMessage', 'lastMessageAt', 'unreadBy', 'typing'
           ]);

      // DELETE: Any participant may delete the chat (cascades to
      // messages via the client-side batch).
      allow delete: if isSignedIn()
        && uid() in resource.data.participants;

      // ----------------------------------------------------------
      // MESSAGES SUBCOLLECTION
      // chats/{chatId}/messages/{messageId}
      // ----------------------------------------------------------
      // Only chat participants can read or write messages.
      // Senders identify themselves automatically; only a sender
      // can delete their own message.
      // ----------------------------------------------------------
      match /messages/{messageId} {

        // READ: Chat participants can read messages (admins can, too —
        // read-only monitoring). Also allow reading when the parent chat
        // does NOT exist yet, so the client gets an empty list instead of
        // a false denial.
        allow read: if isSignedIn()
          && (isAdmin()
              || !exists(/databases/$(database)/documents/chats/$(chatId))
              || uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);

        // CREATE: Only participants can send messages; senderKey
        // must match the authenticated user
        allow create: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderKey == uid();

        // UPDATE: Participants can update (e.g., marking as read). Only the
        // message sender can edit the text.
        allow update: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && (
            // marking as read only touches 'read'
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            ||
            // sender editing text/edited flags
            (resource.data.senderKey == uid()
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.senderKey == resource.data.senderKey
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited']))
          );

        // DELETE: The message sender can delete their own message. Chat
        // participants can also delete messages as part of deleting the
        // whole chat (e.g. "clear chat").
        allow delete: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ============================================================
    // STORIES COLLECTION
    // stories/{storyId}
    // ============================================================
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorKey == uid()
        && request.resource.data.createdAt != null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.keys().hasOnly([
          'authorKey', 'authorName', 'authorAvatar', 'imageUrl', 'text', 'bg',
          'font', 'fontSize', 'mode', 'createdAt', 'expiresAt',
        ]);
      allow delete: if isSignedIn()
        && resource.data.authorKey == uid();
      allow update: if false;

      // Story views: anyone signed in can add their own view, only once
      match /views/{viewerUid} {
        allow read: if isSignedIn()
          && (uid() == resource.data.viewerUid
            || uid() == get(/databases/$(database)/documents/stories/$(storyId)).data.authorKey);
        allow create, update: if isSignedIn()
          && request.resource.data.viewerUid == uid();
        allow delete: if false;
      }
    }

    // ============================================================
    // REELS COLLECTION
    // reels/{reelId}
    // ============================================================
    match /reels/{reelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorKey == uid()
        && request.resource.data.keys().hasAll([
             'authorKey', 'authorName', 'authorAvatar', 'videoUrl',
             'text', 'likes', 'comments', 'shares', 'createdAt'
           ])
        && isValidString(request.resource.data.authorKey, 128)
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0
        && request.resource.data.comments is int
        && request.resource.data.comments >= 0
        && request.resource.data.shares is int
        && request.resource.data.createdAt is timestamp;
      // Previously `allow update: if isSignedIn();` — ANY account could
      // rewrite ANY reel (including authorKey, which then unlocked the
      // delete rule below). Now: only the author may edit their own
      // reel's content fields. Engagement counters (likes/comments/
      // shares) are intentionally NOT writable from the client — the
      // reel UI keeps engagement local, and no client code writes them.
      allow update: if isSignedIn()
        && resource.data.authorKey == uid()
        && request.resource.data.authorKey == resource.data.authorKey
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['text', 'effect', 'sound', 'videoUrl']);
      allow delete: if isSignedIn()
        && resource.data.authorKey == uid();

      // Reel comments — this subcollection had NO rule at all, so every
      // read/write fell through to the catch-all deny and comments on
      // reels silently failed.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorKey == uid()
          && request.resource.data.keys()
               .hasAll(['text', 'authorKey', 'authorName', 'authorAvatar',
                        'likes', 'likedBy', 'createdAt'])
          && isValidString(request.resource.data.text, 2000)
          && isValidString(request.resource.data.authorKey, 128)
          && request.resource.data.likedBy is list
          && request.resource.data.likes is int
          && request.resource.data.createdAt is timestamp;
        // Likes are a self-toggle; a reply may only be appended to or
        // removed from the replies list one element at a time.
        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['replies', 'likes', 'likedBy'])
          && selfToggled('likedBy')
          && request.resource.data.get('likes', 0) is int
          && request.resource.data.get('likes', 0) >= 0
          && request.resource.data.get('likes', 0)
               <= resource.data.get('likes', 0) + 1
          && request.resource.data.get('likes', 0)
               >= resource.data.get('likes', 0) - 1
          && request.resource.data.get('replies', []) is list
          && resource.data.get('replies', []) is list
          && request.resource.data.get('replies', []).size()
               <= resource.data.get('replies', []).size() + 1
          && request.resource.data.get('replies', []).size()
               >= resource.data.get('replies', []).size() - 1;
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.authorKey == uid())
          || (isSignedIn()
              && get(/databases/$(database)/documents/reels/$(reelId))
                   .data.authorKey == uid());
      }
    }

    // ============================================================
    // EVENTS COLLECTION
    // events/{eventId}
    // ============================================================
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.creatorKey == uid();
      // Owner edits everything; anyone else may only toggle their
      // own uid in the attendee list (RSVP) — nothing else.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.creatorKey == uid())
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['attendees'])
            && selfToggled('attendees'));
      allow delete: if isSignedIn()
        && resource.data.creatorKey == uid();
    }

    // ============================================================
    // CHALLENGES COLLECTION
    // challenges/{challengeId}
    // ============================================================
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.creatorKey == uid();
      // Creator edits everything; anyone else may only toggle their
      // own uid in the participant list (Join) — nothing else.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.creatorKey == uid())
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['participants'])
            && selfToggled('participants'));
      allow delete: if isSignedIn()
        && resource.data.creatorKey == uid();
    }

    // ============================================================
    // IDEAS COLLECTION
    // ideas/{ideaId}
    // ============================================================
    match /ideas/{ideaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorKey == uid();
      // Author edits everything; others may only toggle their own
      // upvote or APPEND a comment (never edit/delete someone
      // else's comments).
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.authorKey == uid())
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['upvotedBy'])
            && selfToggled('upvotedBy'))
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['comments'])
            && request.resource.data.comments is list
            && request.resource.data.comments.size()
                 == resource.data.get('comments', []).size() + 1
            && request.resource.data.comments[resource.data.get('comments', []).size()]
                 .authorKey == uid());
      allow delete: if isSignedIn()
        && resource.data.authorKey == uid();
    }

    // ============================================================
    // REPORTS COLLECTION
    // reports/{reportId}
    // ============================================================
    // Any signed-in user can FILE a report (only about themselves as
    // reporter). Reading and resolving reports is admin-only — a
    // normal user can never enumerate reports through the API.
    // ============================================================
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == uid();
      // Admin triage: Pending → Reviewing → Resolved, plus an
      // optional resolution note. Nothing else may be edited.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'resolution', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['pending', 'reviewing', 'resolved'];
      allow delete: if isAdmin();
    }

    // ============================================================
    // BLOCKED SUBCOLLECTION (under users)
    // users/{userId}/blocked/{blockedId}
    // ============================================================
    match /users/{userId}/blocked/{blockedId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // ============================================================
    // ANALYTICS COLLECTION
    // analytics/{eventId}
    // ============================================================
    // Write-once from the client: { eventType, ...payload, createdAt }
    // (payload keys are caller-defined, so they can't be enumerated
    // here). Reading the event stream is admin-only; nobody may edit
    // or delete events.
    // ============================================================
    match /analytics/{eventId} {
      allow read: if isAdmin()
        // Users may read the events they themselves generated (their
        // own post/comment/like activity feeds the personal analytics
        // page). Actor fields vary by event type, so check each.
        || (isSignedIn()
            && (resource.data.get('authorKey', '') == uid()
                || resource.data.get('userId', '') == uid()
                || resource.data.get('followerId', '') == uid()));
      // Previously ANY signed-in user could create events with
      // arbitrary actor fields — e.g. fake analytics for other users.
      // Now the caller must be the actor they claim to be.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['eventType', 'createdAt'])
        && isValidString(request.resource.data.eventType, 100)
        && isValidTimestamp(request.resource.data.createdAt)
        && (request.resource.data.authorKey == uid()
            || request.resource.data.userId == uid()
            || request.resource.data.followerId == uid());
      allow update, delete: if false;
    }

    // ============================================================
    // ADMINS COLLECTION
    // admins/{adminUid}
    // ============================================================
    // THE source of truth for admin authorization (see isAdmin()).
    // Clients may read only their own entry (used to render the
    // admin UI) — NO client may create, update, or delete entries.
    // Seeding/removal happens once from the Firebase Console or the
    // Admin SDK, which bypasses these rules. This is what makes the
    // dashboard impossible to reach by tampering with the frontend.
    // ============================================================
    match /admins/{adminUid} {
      allow read: if isSignedIn() && uid() == adminUid;
      allow write: if false;
    }

    // ============================================================
    // ADMIN ACTIONS (audit trail)
    // adminActions/{actionId}
    // ============================================================
    // Append-only log of moderation decisions. Admin-only: normal
    // users can neither read the log nor forge entries.
    // ============================================================
    match /adminActions/{actionId} {
      allow read, create: if isAdmin()
        && request.resource.data.keys().hasAll(['action', 'createdAt'])
        && isValidString(request.resource.data.action, 50)
        && isValidTimestamp(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    // ============================================================
    // FOUNDATORS VOICE (voiceRooms + subcollections)
    // ============================================================

    function voiceRoomData(roomId) {
      return get(/databases/$(database)/documents/voiceRooms/$(roomId)).data;
    }

    // Role-based checks for the AUTHENTICATED caller inside a room.
    // exists() guards every get() so a caller WITHOUT a participant
    // document (e.g. a listener about to join) gets a clean `false`
    // instead of an evaluation error that would deny the request.
    function voiceParticipantIs(roomId, role) {
      return exists(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(request.auth.uid))
        && get(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(request.auth.uid)).data.role == role;
    }

    function voiceParticipantIn(roomId, roles) {
      return exists(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(request.auth.uid))
        && get(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(request.auth.uid)).data.role in roles;
    }

    // Public rooms are open; followers-only rooms require a follow
    // edge; private rooms are readable only by host or participants.
    function voiceRoomReadable(room, roomId) {
      return isSignedIn()
        && (room.hostId == uid()
            || room.type == 'public'
            || (room.type == 'followers'
                && exists(/databases/$(database)/documents/users/$(uid())/following/$(room.hostId)))
            || exists(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(uid())));
    }

    match /voiceRooms/{roomId} {
      allow read: if voiceRoomReadable(resource.data, roomId) || isAdmin();

      // Only a signed-in user can create a room, and only as their
      // own room (hostId can never be spoofed onto someone else).
      allow create: if isSignedIn()
        && request.resource.data.roomId == roomId
        && request.resource.data.hostId == uid()
        && isValidString(request.resource.data.title, 120)
        && request.resource.data.type in ['public', 'followers', 'private']
        && request.resource.data.status in ['live', 'scheduled'];

      // hostId is immutable (no room hijacking). The room host has full
      // control; co-hosts may only touch moderation/count fields; admins
      // may moderate anything.
      allow update: if isSignedIn()
        && request.resource.data.get('hostId', '') == resource.data.hostId
        && request.resource.data.get('roomId', '') == resource.data.roomId
        && request.resource.data.status in ['scheduled', 'live', 'ended']
        && (
          resource.data.hostId == uid()
          || isAdmin()
          || (voiceParticipantIs(roomId, 'coHost')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'title', 'description', 'pinnedTopic', 'isLocked',
                'participantCount', 'speakerCount', 'previewAvatars',
                'allowRaiseHand', 'allowReactions', 'allowQuestions', 'maxSpeakers'
              ]))
        );

      allow delete: if isSignedIn() && (resource.data.hostId == uid() || isAdmin());

      match /participants/{pid} {
        allow read: if voiceRoomReadable(voiceRoomData(roomId), roomId) || isAdmin();

        // Self-join is only possible into a live, unlocked public or
        // followers-only room as a listener (never as speaker/host),
        // and never if the host has blocked you. The host/co-host may
        // add invited participants. The creator joins as host.
        allow create: if isSignedIn()
          && request.resource.data.uid == pid
          && request.resource.data.status in ['joined', 'invited']
          && (
            (pid == uid()
              && voiceRoomData(roomId).hostId == uid()
              && request.resource.data.role == 'host')
            || (voiceParticipantIn(roomId, ['host', 'coHost'])
                && pid != uid()
                && request.resource.data.role == 'listener')
            || (pid == uid()
                && request.resource.data.role == 'listener'
                && voiceRoomData(roomId).status == 'live'
                && voiceRoomData(roomId).isLocked == false
                && voiceRoomData(roomId).type in ['public', 'followers']
                && (voiceRoomData(roomId).type == 'public'
                    || exists(/databases/$(database)/documents/users/$(uid())/following/$(voiceRoomData(roomId).hostId)))
                && !exists(/databases/$(database)/documents/users/$(voiceRoomData(roomId).hostId)/blocked/$(uid())))
          );

        // A participant may only edit their own presence fields, may
        // never upgrade themselves (listener -> speaker is denied),
        // and may only step DOWN from speaker/co-host. Moderators may
        // change other people's roles; only the room host assigns
        // co-host. No body can take the host's own document.
        allow update: if isSignedIn()
          && (
            (pid == uid()
              && request.resource.data.get('uid', pid) == pid
              && request.resource.data.status in ['joined', 'left']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'isMuted', 'raisedHand', 'lastActiveAt', 'status', 'role',
                'name', 'avatar', 'invited'
              ])
              && (request.resource.data.role == resource.data.role
                  || (request.resource.data.role == 'listener'
                      && resource.data.role in ['speaker', 'coHost'])))
            || (isSignedIn()
                && voiceRoomData(roomId).hostId == uid()
                && pid != uid()
                && request.resource.data.role in ['listener', 'speaker', 'coHost']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'role', 'isMuted', 'status', 'raisedHand'
                ]))
            || (isSignedIn()
                && voiceParticipantIs(roomId, 'coHost')
                && pid != uid()
                && voiceRoomData(roomId).hostId != pid
                && request.resource.data.role in ['listener', 'speaker']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'role', 'isMuted', 'status'
                ]))
            || isAdmin()
          );

        // Self-leave, host/co-host kick, admin cleanup. Nobody can
        // remove the host from their own room.
        allow delete: if isSignedIn()
          && (
            pid == uid()
            || (voiceRoomData(roomId).hostId == uid() && pid != uid())
            || (voiceParticipantIs(roomId, 'coHost')
                && pid != uid()
                && voiceRoomData(roomId).hostId != pid)
            || isAdmin()
          );
      }

      match /speakerRequests/{reqId} {
        allow read: if isSignedIn()
          && (reqId == uid() || voiceParticipantIn(roomId, ['host', 'coHost']));
        allow create: if isSignedIn()
          && reqId == uid()
          && request.resource.data.uid == uid()
          && request.resource.data.status == 'pending'
          && voiceRoomData(roomId).status == 'live'
          && voiceRoomData(roomId).allowRaiseHand == true
          && voiceRoomData(roomId).isLocked == false
          && get(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(uid())).data.role == 'listener';
        allow update: if isAdmin() || (isSignedIn() && voiceParticipantIn(roomId, ['host', 'coHost']));
        allow delete: if isAdmin() || (isSignedIn() && (reqId == uid() || voiceParticipantIn(roomId, ['host', 'coHost'])));
      }

      match /questions/{qid} {
        allow read: if voiceRoomReadable(voiceRoomData(roomId), roomId) || isAdmin();
        allow create: if isSignedIn()
          && request.resource.data.authorId == uid()
          && isValidString(request.resource.data.text, 500)
          && voiceRoomData(roomId).allowQuestions == true
          && exists(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(uid()));
        // Authors may edit only their own text; moderators control
        // moderation state (pending/pinned/answered).
        allow update: if isAdmin()
          || (isSignedIn()
              && resource.data.authorId == uid()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']))
          || (isSignedIn()
              && voiceParticipantIn(roomId, ['host', 'coHost'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.authorId == uid())
          || (isSignedIn() && voiceParticipantIn(roomId, ['host', 'coHost']));
      }

      match /reactions/{reactionId} {
        allow read: if voiceRoomReadable(voiceRoomData(roomId), roomId) || isAdmin();
        allow create: if isSignedIn()
          && request.resource.data.userId == uid()
          && voiceRoomData(roomId).allowReactions != false
          && voiceRoomReadable(voiceRoomData(roomId), roomId);
        allow update: if false;
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == uid())
          || (isSignedIn() && voiceParticipantIn(roomId, ['host', 'coHost']));
      }

      // WebRTC signaling (SDP/ICE) - ephemeral, only between two
      // participants of the same room, consumed (deleted) on read.
      match /signals/{signalId} {
        allow read: if isSignedIn()
          && voiceParticipantIn(roomId, ['host', 'coHost', 'speaker', 'listener'])
          && (resource.data.from == uid() || resource.data.to == uid());
        allow create: if isSignedIn()
          && request.resource.data.from == uid()
          && request.resource.data.to != uid()
          && request.resource.data.kind in ['sdp', 'ice', 'nudge']
          && voiceParticipantIn(roomId, ['host', 'coHost', 'speaker', 'listener']);
        allow update: if false;
        // The recipient consumes a signal, the sender prunes its own,
        // and the room host (or an admin) may purge all signaling in
        // their room when ending it.
        allow delete: if isSignedIn()
          && (resource.data.from == uid()
              || resource.data.to == uid()
              || voiceRoomData(roomId).hostId == uid()
              || isAdmin());
      }

      match /reminders/{remUid} {
        allow read: if isSignedIn()
          && (remUid == uid() || voiceRoomData(roomId).hostId == uid() || isAdmin());
        allow create: if isSignedIn() && remUid == uid();
        allow update: if false;
        allow delete: if isSignedIn()
          && (remUid == uid() || voiceRoomData(roomId).hostId == uid() || isAdmin());
      }
    }

    // Per-user reminder bookmarks (enables one-tap toggle state).
    match /users/{userId}/voiceReminders/{voiceReminderId} {
      allow read, write: if isOwner(userId);
    }

    // ============================================================
    // OPPORTUNITIES COLLECTION
    // opportunities/{opportunityId}
    // ============================================================
    // Curated jobs/funding/projects. Readable by any signed-in user;
    // writes only by admins (seeded via console/Cloud Functions).
    // ============================================================
    match /opportunities/{opportunityId} {
      allow read: if isSignedIn();
      // Note: request.resource.data is null on delete, so validation
      // is attached to create/update only and delete is admin-only.
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'createdAt'])
        && isValidString(request.resource.data.title, 200)
        && isValidTimestamp(request.resource.data.createdAt);
      allow delete: if isAdmin();
    }

    // ============================================================
    // PENDING NOTIFICATIONS COLLECTION
    // pending-notifications/{notificationId}
    // ============================================================
    // Stores push notification payloads for external processing
    // (Cloud Function picks these up and sends via FCM Admin SDK).
    // Client may enqueue a notification for ANY user (targetUserId)
    // but must include a valid recipient and bounded payload.
    // ============================================================
    match /pending-notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
             'targetUserId', 'title', 'body', 'data', 'sent', 'createdAt'
           ])
        && isValidString(request.resource.data.targetUserId, 128)
        && exists(/databases/$(database)/documents/users/$(request.resource.data.targetUserId))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 500
        && request.resource.data.data is map
        && request.resource.data.sent == false
        && isValidTimestamp(request.resource.data.createdAt);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sent']);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
