NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Image/video uploads (Cloudinary). The NEXT_PUBLIC_ var is read by the
# browser; the server vars are used to sign uploads in app/api/cloudinary/sign.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (Resend). Server-only - never NEXT_PUBLIC_.
# Verify your domain first: https://resend.com/domains
# EMAIL_FROM must use that verified domain, e.g. "FOUNDATORS <hello@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=

# AI Copilot (server-only). Optional - without a key the Copilot page
# degrades gracefully (E2E S28 asserts no crash).
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional error tracking (browser).
NEXT_PUBLIC_SENTRY_DSN=

# QA / local development: set to 1 to point the Firebase SDKs at the local
# emulators (Auth 9099, Firestore 8080, Storage 9199). Leave unset in
# production. See TESTING.md.
NEXT_PUBLIC_USE_EMULATORS=
